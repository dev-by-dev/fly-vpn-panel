# flypanel environment template.
# Copy to .env on the server, fill real values, chmod 600.
# The panel reads this file (path selectable via FLYPANEL_ENV, default ./.env);
# process environment variables do not override file values.

DATA_DIR=./data
LISTEN_ADDR=127.0.0.1:3002
XRAY_BIN=./bin/xray
POLL_INTERVAL_SEC=30
ENTRY_IP=<ENTRY_IP>
PANEL_DOMAIN=<PANEL_DOMAIN>
# Empty by default: egress through the entry server until set.
EGRESS_IP=
