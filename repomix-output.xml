import { test, expect, vi, beforeEach, afterEach } from 'vitest';
import { render, screen, fireEvent, cleanup, waitFor } from '@testing-library/svelte';
import UserDialog from './UserDialog.svelte';

// Anonymized fixture: quota-disabled user (checkbox starts unchecked).
const quotaUser = {
  id: 7,
  username: 'carol',
  expiry: '2027-01-01T00:00:00Z',
  quota_bytes: 10737418240,
  quota_period: 'month',
  device_limit: 0,
  disabled: true,
  disabled_reason: 'quota',
};

let fetchMock: ReturnType<typeof vi.fn>;

beforeEach(() => {
  fetchMock = vi.fn().mockResolvedValue(new Response(JSON.stringify({ ok: true }), { status: 200 }));
  vi.stubGlobal('fetch', fetchMock);
});

afterEach(() => {
  cleanup();
  vi.unstubAllGlobals();
});

function submit() {
  const form = document.querySelector('form');
  if (!form) throw new Error('form not found');
  fireEvent.submit(form);
}

function patchBody(): Record<string, unknown> {
  const call = fetchMock.mock.calls.find(([u]) => String(u) === '/api/users/7');
  if (!call) throw new Error('PATCH /api/users/7 not called');
  return JSON.parse(String(call[1].body));
}

test('квота-отключённый юзер: чекбокс не тронут → disabled не отправляется', async () => {
  render(UserDialog, {
    props: { user: { ...quotaUser }, onsaved: () => {}, onclose: () => {} },
  });

  submit();
  await waitFor(() => expect(fetchMock).toHaveBeenCalled());

  const body = patchBody();
  expect('disabled' in body).toBe(false);
  expect(body.quota_bytes).toBe(10737418240);
});

test('чекбокс переключен → disabled отправляется', async () => {
  render(UserDialog, {
    props: { user: { ...quotaUser }, onsaved: () => {}, onclose: () => {} },
  });

  await fireEvent.click(screen.getByRole('checkbox'));
  submit();
  await waitFor(() => expect(fetchMock).toHaveBeenCalled());

  const body = patchBody();
  expect(body.disabled).toBe(true);
});
</file>

<file path="cmd/flypanel/admin.go">
package main

import (
	"bufio"
	"errors"
	"flag"
	"fmt"
	"io"
	"os"
	"strings"

	"golang.org/x/term"

	"flypanel/internal/auth"
	"flypanel/internal/config"
	"flypanel/internal/store"
)

// adminCommand implements `flypanel admin init`: interactive username and
// password prompts (or --password-stdin for automation) creating the single
// admin account.
func adminCommand(args []string) {
	if len(args) == 0 || args[0] != "init" {
		fmt.Fprintln(os.Stderr, "usage: flypanel admin init [--data-dir DIR] [--password-stdin] [username]")
		os.Exit(2)
	}
	fs := flag.NewFlagSet("admin init", flag.ExitOnError)
	dataDir := fs.String("data-dir", "", "data directory (default: DATA_DIR from the env file)")
	passwordStdin := fs.Bool("password-stdin", false, "read the password from stdin without confirmation")
	fs.Parse(args[1:])

	username := ""
	if fs.NArg() > 0 {
		username = fs.Arg(0)
	}

	cfg, err := config.Load()
	if err != nil {
		fatalf("admin init: %v", err)
	}
	dir := *dataDir
	if dir == "" {
		dir = cfg.DataDir
	}

	if username == "" {
		username, err = promptLine("admin username: ")
		if err != nil {
			fatalf("admin init: %v", err)
		}
	}

	password, err := readPassword(*passwordStdin)
	if err != nil {
		fatalf("admin init: %v", err)
	}

	st, err := store.Open(dir)
	if err != nil {
		fatalf("admin init: %v", err)
	}
	defer st.Close()

	if err := auth.AdminInit(st, username, password); err != nil {
		fatalf("admin init: %v", err)
	}
	fmt.Println("admin account created")
}

// readPassword reads the password from stdin when --password-stdin is set;
// otherwise it prompts twice via the terminal with confirmation.
func readPassword(stdin bool) (string, error) {
	if stdin {
		data, err := io.ReadAll(os.Stdin)
		if err != nil {
			return "", err
		}
		return strings.TrimRight(string(data), "\r\n"), nil
	}
	fmt.Fprint(os.Stderr, "admin password (min 12 chars): ")
	pw, err := term.ReadPassword(int(os.Stdin.Fd()))
	fmt.Fprintln(os.Stderr)
	if err != nil {
		return "", err
	}
	fmt.Fprint(os.Stderr, "confirm password: ")
	confirm, err := term.ReadPassword(int(os.Stdin.Fd()))
	fmt.Fprintln(os.Stderr)
	if err != nil {
		return "", err
	}
	if string(pw) != string(confirm) {
		return "", errors.New("passwords do not match")
	}
	return string(pw), nil
}

func promptLine(prompt string) (string, error) {
	fmt.Fprint(os.Stderr, prompt)
	line, err := bufio.NewReader(os.Stdin).ReadString('\n')
	if err != nil {
		return "", err
	}
	return strings.TrimSpace(line), nil
}

func fatalf(format string, args ...any) {
	fmt.Fprintf(os.Stderr, format+"\n", args...)
	os.Exit(1)
}
