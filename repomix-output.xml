      <tr>
        <th class="px-3 py-2 font-medium">Tag</th>
        <th class="px-3 py-2 font-medium">Порт</th>
        <th class="px-3 py-2 font-medium">Path</th>
        <th class="px-3 py-2 font-medium">Включён</th>
