<file path="internal/xray/proc_test.go">
package xray

import (
	"os"
	"os/exec"
	"path/filepath"
	"strings"
	"syscall"
	"testing"
	"time"
)

const fakeVersionLine = "Xray 25.11.20 (flypanel test fake)"

// fakeXrayVersion handles the `version` probe Manager runs at startup.
const fakeXrayVersion = `if [ "$1" = "version" ]; then
	echo "` + fakeVersionLine + `"
	exit 0
fi
`

// fakeXray writes a shell script standing in for the xray binary and returns
// its path. Only this spawned script is ever signalled by the tests.
func fakeXray(t *testing.T, body string) string {
	t.Helper()
	// shortcut: macOS sleep lacks "infinity", so 24h stands in for it.
	path := filepath.Join(t.TempDir(), "xray")
	if err := os.WriteFile(path, []byte("#!/bin/sh\n"+fakeXrayVersion+body), 0o755); err != nil {
		t.Fatalf("write fake xray: %v", err)
	}
	return path
}

// waitRestarts polls until Status().Restarts reaches want.
func waitRestarts(t *testing.T, m *Manager, want int, timeout time.Duration) {
	t.Helper()
	deadline := time.Now().Add(timeout)
	for time.Now().Before(deadline) {
		if m.Status().Restarts >= want {
			return
		}
		time.Sleep(20 * time.Millisecond)
	}
	t.Fatalf("Restarts never reached %d within %v, last status %+v", want, timeout, m.Status())
}

// processGone fails if pid still exists — signal 0 succeeds on zombies too,
// so passing here means the child was fully reaped, not left undead.
func processGone(t *testing.T, pid int) {
	t.Helper()
	deadline := time.Now().Add(2 * time.Second)
	for time.Now().Before(deadline) {
		if syscall.Kill(pid, 0) != nil {
			return
		}
		time.Sleep(20 * time.Millisecond)
	}
	t.Errorf("pid %d still present after Stop (zombie or leaked?)", pid)
}

// assertNoLeftovers scans the process table for anything still referencing
// the fake binary path (dead or alive).
func assertNoLeftovers(t *testing.T, binPath string) {
	t.Helper()
	out, err := exec.Command("ps", "-axo", "stat=,command=").Output()
	if err != nil {
		t.Fatalf("ps: %v", err)
	}
	for _, line := range strings.Split(string(out), "\n") {
		if strings.Contains(line, binPath) {
			t.Errorf("process left behind after Stop: %s", strings.TrimSpace(line))
		}
	}
}

func TestManagerStartStop(t *testing.T) {
	bin := fakeXray(t, "exec sleep 86400\n")
	m := NewManager(bin, filepath.Join(filepath.Dir(bin), "config.json"))

	if err := m.Start(); err != nil {
		t.Fatalf("Start(): %v", err)
	}
	st := m.Status()
	if !st.Running || st.PID <= 0 {
		t.Fatalf("Status() after Start = %+v, want running with a PID", st)
	}
	if st.Version != fakeVersionLine {
		t.Errorf("Version = %q, want %q", st.Version, fakeVersionLine)
	}
	if st.Uptime < 0 {
		t.Errorf("Uptime = %v, want >= 0", st.Uptime)
	}
	pid := st.PID

	if err := m.Stop(); err != nil {
		t.Fatalf("Stop(): %v", err)
	}
	if m.Status().Running {
		t.Error("Status().Running after Stop = true, want false")
	}
	processGone(t, pid)
	assertNoLeftovers(t, bin)

	if err := m.Restart(); err != nil {
		t.Fatalf("Restart(): %v", err)
	}
	st2 := m.Status()
	if !st2.Running || st2.PID <= 0 {
		t.Fatalf("Status() after Restart = %+v, want running with a PID", st2)
	}
	if err := m.Stop(); err != nil {
		t.Fatalf("Stop() after Restart: %v", err)
	}
	processGone(t, st2.PID)
	assertNoLeftovers(t, bin)
}

func TestManagerCrashBackoff(t *testing.T) {
	bin := fakeXray(t, "exit 1\n")
	m := NewManager(bin, filepath.Join(filepath.Dir(bin), "config.json"))

	if err := m.Start(); err != nil {
		t.Fatalf("Start(): %v", err)
	}
	// The script dies immediately; the manager must count the crash and
	// respawn it. Two crashes also prove the backoff loop keeps going.
	waitRestarts(t, m, 2, 8*time.Second)

	if err := m.Stop(); err != nil {
		t.Fatalf("Stop(): %v", err)
	}
	if m.Status().Running {
		t.Error("Status().Running after Stop = true, want false")
	}
	if m.Status().Restarts < 2 {
		t.Errorf("Restarts after Stop = %d, want >= 2", m.Status().Restarts)
	}
	assertNoLeftovers(t, bin)
}

func TestApplyAtomicFailureKeepsOld(t *testing.T) {
	dir := t.TempDir()
	cfgPath := filepath.Join(dir, "xray.json")
	if err := os.WriteFile(cfgPath, []byte("old config"), 0o644); err != nil {
		t.Fatalf("write old config: %v", err)
	}

	// Target directory does not exist: the temp write fails, rename never
	// happens, and the old file must be untouched.
	if err := ApplyAtomic(filepath.Join(dir, "nope", "xray.json"), []byte("new config")); err == nil {
		t.Error("ApplyAtomic(missing dir) = nil error, want error")
	}
	got, err := os.ReadFile(cfgPath)
	if err != nil {
		t.Fatalf("read old config: %v", err)
	}
	if string(got) != "old config" {
		t.Errorf("old file content after failed apply = %q, want %q", got, "old config")
	}

	// Happy path: the rename swaps the content atomically.
	if err := ApplyAtomic(cfgPath, []byte("new config")); err != nil {
		t.Fatalf("ApplyAtomic(): %v", err)
	}
	got, err = os.ReadFile(cfgPath)
	if err != nil {
		t.Fatalf("read new config: %v", err)
	}
	if string(got) != "new config" {
		t.Errorf("file content after apply = %q, want %q", got, "new config")
	}
}
</file>

<file path="internal/xray/proc.go">
package xray

import (
	"fmt"
	"os/exec"
	"strings"
	"sync"
	"syscall"
	"time"
)

// Status is a point-in-time snapshot of the xray child process.
type Status struct {
	Running  bool
	PID      int
	Uptime   time.Duration
	Restarts int
	Version  string
}

// Manager owns the xray child process: start, graceful stop (SIGTERM with a
// 5s deadline, then SIGKILL), and automatic restart after a crash with
// exponential backoff (1s doubling, capped at 30s).
type Manager struct {
	binPath string
	cfgPath string

	mu        sync.Mutex
	cmd       *exec.Cmd
	running   bool
	startedAt time.Time
	restarts  int
	version   string
	stopped   bool
	stopCh    chan struct{}
	wg        sync.WaitGroup
}

// NewManager returns a Manager for the given xray binary and config path.
// Nothing is started until Start is called.
func NewManager(binPath, cfgPath string) *Manager {
	return &Manager{binPath: binPath, cfgPath: cfgPath}
}

// Start launches xray, captures its version, and begins supervising it.
// It is a no-op if xray is already running or a crash restart is pending.
func (m *Manager) Start() error {
	m.mu.Lock()
	defer m.mu.Unlock()
	if m.running || (m.stopCh != nil && !m.stopped) {
		return nil
	}
	m.version = ""
	if out, err := exec.Command(m.binPath, "version").Output(); err == nil {
		line, _, _ := strings.Cut(string(out), "\n")
		m.version = strings.TrimSpace(line)
	}
	cmd := exec.Command(m.binPath, "run", "-c", m.cfgPath)
	if err := cmd.Start(); err != nil {
		return fmt.Errorf("xray start: %w", err)
	}
	m.stopCh = make(chan struct{})
	m.stopped = false
	m.cmd = cmd
	m.running = true
	m.startedAt = time.Now()
	m.wg.Add(1)
	go m.supervise(cmd)
	return nil
}

// Stop terminates xray gracefully: SIGTERM, up to 5s wait, then SIGKILL.
// It blocks until the child is fully reaped, so no zombie is left behind.
func (m *Manager) Stop() error {
	m.mu.Lock()
	if m.cmd == nil {
		m.mu.Unlock()
		return nil
	}
	if !m.stopped {
		m.stopped = true
		close(m.stopCh)
	}
	cmd := m.cmd
	m.mu.Unlock()

	if cmd.Process != nil {
		_ = cmd.Process.Signal(syscall.SIGTERM)
	}
	deadline := time.Now().Add(5 * time.Second)
	for time.Now().Before(deadline) && m.Status().Running {
		time.Sleep(50 * time.Millisecond)
	}
	m.mu.Lock()
	if m.running && m.cmd != nil && m.cmd.Process != nil {
		_ = m.cmd.Process.Kill()
	}
	m.running = false
	m.cmd = nil
	m.mu.Unlock()

	m.wg.Wait()
	return nil
}

// Restart stops xray (fully) and starts it again.
func (m *Manager) Restart() error {
	if err := m.Stop(); err != nil {
		return err
	}
	return m.Start()
}

// Status returns the current snapshot of the child process.
func (m *Manager) Status() Status {
	m.mu.Lock()
	defer m.mu.Unlock()
	st := Status{Running: m.running, Restarts: m.restarts, Version: m.version}
	if m.running && m.cmd != nil && m.cmd.Process != nil {
		st.PID = m.cmd.Process.Pid
		st.Uptime = time.Since(m.startedAt)
	}
	return st
}

// supervise reaps the child and restarts it after crashes, growing the
// backoff from 1s to a 30s cap. It exits when Stop closes stopCh.
func (m *Manager) supervise(cmd *exec.Cmd) {
	defer m.wg.Done()
	for {
		_ = cmd.Wait()
		m.mu.Lock()
		m.running = false
		if m.stopped {
			m.cmd = nil
			m.mu.Unlock()
			return
		}
		m.restarts++
		stopCh := m.stopCh
		backoff := backoffFor(m.restarts)
		m.mu.Unlock()

		select {
		case <-stopCh:
			return
		case <-time.After(backoff):
		}

		m.mu.Lock()
		if m.stopped {
			m.mu.Unlock()
			return
		}
		next := exec.Command(m.binPath, "run", "-c", m.cfgPath)
		if err := next.Start(); err != nil {
			m.mu.Unlock()
			continue // retry on the next loop iteration, after another backoff
		}
		m.cmd = next
		m.running = true
		m.startedAt = time.Now()
		cmd = next
		m.mu.Unlock()
	}
}

// backoffFor returns the sleep before restart number `restarts`:
// 1s, 2s, 4s, 8s, 16s, then capped at 30s.
func backoffFor(restarts int) time.Duration {
	d := time.Second
	for range max(restarts-1, 0) {
		d *= 2
		if d >= 30*time.Second {
			return 30 * time.Second
		}
	}
	return d
}
