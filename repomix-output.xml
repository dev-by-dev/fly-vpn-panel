<file path="web/src/lib/components/InboundForm.svelte">
<script lang="ts">
  import { Button } from '$lib/components/ui/button';
  import { Input } from '$lib/components/ui/input';
  import { Label } from '$lib/components/ui/label';
  import { apiFetch } from '$lib/api';

  type InboundRow = { id: number; tag: string; enabled: boolean; config: Record<string, unknown> };

  type Props = { inbound: InboundRow | null; onsaved: () => void; onclose: () => void };
  let { inbound, onsaved, onclose }: Props = $props();

  const isEdit = inbound !== null;
  const cfg0: Record<string, any> = inbound?.config ?? {};
  const rs0 = cfg0.streamSettings?.realitySettings ?? {};
  const xh0 = cfg0.streamSettings?.xhttpSettings ?? {};

  let tag = $state(inbound?.tag ?? '');
  // Дефолты по спеке: 8443 и stream-up (443/auto ломали свежий inbound).
  let port = $state<number>(cfg0.port ?? 8443);
  let path = $state<string>(xh0.path ?? '/xhttp');
  let mode = $state<string>(xh0.mode ?? 'stream-up');
  let dest = $state<string>(rs0.dest ?? 'www.microsoft.com:443');
  let serverNames = $state<string>((rs0.serverNames ?? []).join(','));
  let shortIds = $state<string>((rs0.shortIds ?? []).join(','));
  let fp = $state<string>(rs0.fingerprint ?? 'chrome');
  let raw = $state('');
  let rawDirty = $state(false);
  let error = $state('');
  let saving = $state(false);

  // структурные поля пишутся в JSON; ручное редактирование textarea имеет приоритет
  function build(): Record<string, any> {
    const cfg = structuredClone(cfg0);
    cfg.port = port;
    const ss = (cfg.streamSettings ??= {});
    ss.network = 'xhttp';
    const xh = (ss.xhttpSettings ??= {});
    xh.path = path;
    xh.mode = mode;
    const rs = (ss.realitySettings ??= {});
    rs.dest = dest;
    rs.serverNames = serverNames.split(',').map((s) => s.trim()).filter(Boolean);
    rs.shortIds = shortIds.split(',').map((s) => s.trim()).filter(Boolean);
    rs.fingerprint = fp;
    if (cfg.protocol == null) cfg.protocol = 'vless';
    if (cfg.settings == null) cfg.settings = { clients: [] };
    return cfg;
  }

  function pretty(cfg: Record<string, unknown>): string {
    return JSON.stringify(cfg, null, 2);
  }

  const applyWarn = 'Сохранено в БД, но применить не удалось — xray работает со старым конфигом, повторите позже.';

  async function submit(e: SubmitEvent) {
    e.preventDefault();
    error = '';
    if (tag.trim() === '') {
      error = 'Укажите tag';
      return;
    }
    let cfg: Record<string, unknown>;
    try {
      cfg = rawDirty ? (JSON.parse(raw) as Record<string, unknown>) : build();
    } catch {
      error = 'Невалидный JSON';
      return;
    }
    saving = true;
    try {
      const res = await apiFetch(isEdit ? `/api/inbounds/${inbound!.id}` : '/api/inbounds', {
        method: isEdit ? 'PATCH' : 'POST',
        body: JSON.stringify(isEdit ? { tag: tag.trim(), config: cfg } : { tag: tag.trim(), enabled: true, config: cfg }),
      });
      if (res.status === 502) {
        alert(applyWarn);
        onsaved();
        return;
      }
      if (!res.ok) {
        const data = (await res.json().catch(() => ({}))) as { error?: string };
        error = `Ошибка: ${data.error ?? res.status}`;
        return;
      }
      if (!isEdit) {
        // у нового inbound пустые Reality-ключи: генерируем сразу, иначе xray не применит конфиг
        const created = (await res.json()) as { id: number };
        const keys = await apiFetch(`/api/inbounds/${created.id}/keys`, { method: 'POST' });
        if (keys.status === 502) alert(applyWarn);
      }
      onsaved();
    } catch {
      error = 'Сеть недоступна';
    } finally {
      saving = false;
    }
  }
</script>

<div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4" role="dialog" aria-modal="true">
  <div class="max-h-[90vh] w-full max-w-lg overflow-y-auto rounded-xl border bg-card p-5 shadow-lg">
    <h2 class="text-lg font-semibold">{isEdit ? 'Изменить inbound' : 'Новый inbound'}</h2>
    <p class="mt-1 text-xs text-yellow-400">Применение = рестарт xray ~1–2 с</p>
    <form class="mt-4 grid gap-4" onsubmit={submit}>
      <div class="grid gap-1.5">
        <Label for="i-tag">Tag</Label>
        <Input id="i-tag" bind:value={tag} placeholder="in-443" />
      </div>
      <div class="grid gap-1.5">
        <Label for="i-port">Порт</Label>
        <Input id="i-port" type="number" min="1" max="65535" bind:value={port} />
      </div>
      <div class="grid gap-1.5">
        <Label for="i-path">Path</Label>
        <Input id="i-path" bind:value={path} placeholder="/xhttp" />
      </div>
      <div class="grid gap-1.5">
        <Label for="i-mode">Режим xhttp</Label>
        <select
          id="i-mode"
          bind:value={mode}
          class="border-input bg-input/30 h-8 w-full rounded-lg border px-2.5 text-sm outline-none"
        >
          <option value="auto">auto</option>
          <option value="packet-up">packet-up</option>
          <option value="stream-up">stream-up</option>
          <option value="stream-one">stream-one</option>
        </select>
      </div>
      <div class="grid gap-1.5">
        <Label for="i-dest">Reality dest</Label>
        <Input id="i-dest" bind:value={dest} placeholder="www.microsoft.com:443" />
      </div>
      <div class="grid gap-1.5">
        <Label for="i-sni">serverNames (через запятую)</Label>
        <Input id="i-sni" bind:value={serverNames} placeholder="www.microsoft.com" />
      </div>
      <div class="grid gap-1.5">
        <Label for="i-sids">shortIds (через запятую)</Label>
        <Input id="i-sids" bind:value={shortIds} placeholder="" />
      </div>
      <div class="grid gap-1.5">
        <Label for="i-fp">Fingerprint</Label>
        <select
          id="i-fp"
          bind:value={fp}
          class="border-input bg-input/30 h-8 w-full rounded-lg border px-2.5 text-sm outline-none"
        >
          {#each ['chrome', 'firefox', 'safari', 'ios', 'android', 'edge', 'randomized'] as f (f)}
            <option value={f}>{f}</option>
          {/each}
        </select>
      </div>
      <div class="grid gap-1.5">
        <Label for="i-raw">Конфиг inbound (JSON)</Label>
        <textarea
          id="i-raw"
          rows="10"
          class="border-input bg-input/30 w-full rounded-lg border p-2.5 font-mono text-xs outline-none"
          value={rawDirty ? raw : pretty(build())}
          oninput={(e) => {
            raw = e.currentTarget.value;
            rawDirty = true;
          }}
        ></textarea>
      </div>
      {#if error}
        <p class="text-sm text-red-400">{error}</p>
      {/if}
      <div class="mt-1 flex justify-end gap-2">
        <Button type="button" variant="outline" onclick={onclose}>Отмена</Button>
        <Button type="submit" disabled={saving}>{saving ? 'Применение…' : 'Сохранить'}</Button>
      </div>
    </form>
  </div>
</div>
</file>

<file path="web/src/lib/components/TrafficChart.svelte">
<script lang="ts">
  import { onMount } from 'svelte';
  import { toSeries, type Bucket } from '$lib/traffic';

  let { buckets = [], height = 260 }: { buckets?: Bucket[]; height?: number } = $props();

  let el = $state<HTMLDivElement | null>(null);
  // chart — non-reactive: mutated imperatively, $effect pushes data into it.
  let chart: import('uplot').default | null = null;

  const opts = (h: number) => ({
    width: 0, // set after mount from el.clientWidth
    height: h,
    class: 'uplot-dark',
    series: [
      {},
      {
        label: 'Отдача',
        stroke: '#34d399',
        fill: 'rgba(52,211,153,0.15)',
        value: (u: unknown, v: number) => (v == null ? '—' : v.toFixed(0)),
      },
      {
        label: 'Загрузка',
        stroke: '#60a5fa',
        fill: 'rgba(96,165,250,0.15)',
        value: (u: unknown, v: number) => (v == null ? '—' : v.toFixed(0)),
      },
    ],
    scales: { x: { time: true } },
    axes: [
      { stroke: '#64748b', grid: { stroke: 'rgba(100,116,139,0.15)' }, ticks: { stroke: '#64748b' } },
      { stroke: '#64748b', grid: { stroke: 'rgba(100,116,139,0.15)' }, ticks: { stroke: '#64748b' } },
    ],
    legend: { live: false },
  });

  onMount(() => {
    let dead = false;
    void (async () => {
      // Dynamic import: uPlot touches canvas/DOM APIs, browser-only.
      const UPlot = (await import('uplot')).default;
      if (dead || !el) return;
      const conf = opts(height);
      conf.width = el.clientWidth || 600;
      chart = new UPlot(conf, toSeries(buckets), el);
    })();
    return () => {
      dead = true;
      chart?.destroy();
      chart = null;
    };
  });

  $effect(() => {
    // buckets read here makes the effect re-run on data reload.
    if (chart) chart.setData(toSeries(buckets));
  });
</script>

<!-- shortcut: no ResizeObserver, chart width fixed at mount -->
<div bind:this={el} class="w-full"></div>
</file>

<file path="web/src/lib/components/UserDialog.svelte">
<script lang="ts">
  import { Button } from '$lib/components/ui/button';
  import { Input } from '$lib/components/ui/input';
  import { Label } from '$lib/components/ui/label';
  import { apiFetch } from '$lib/api';

  type UserRow = {
    id: number;
    username: string;
    expiry: string;
    quota_bytes: number;
    quota_period: string;
    device_limit: number;
    disabled: boolean;
    disabled_reason: string;
  };

  type Props = { user: UserRow | null; onsaved: () => void; onclose: () => void };
  let { user, onsaved, onclose }: Props = $props();

  const isEdit = user !== null;
  const GB = 1024 ** 3;

  // shortcut: квота в ГБ с 3 знаками — погрешность ≤1 МБ против байтового ввода
  let username = $state(user?.username ?? '');
  // новый юзер: +30 дней по умолчанию
  let expiry = $state(toLocalInput(user?.expiry ?? new Date(Date.now() + 30 * 864e5).toISOString()));
  let quotaGB = $state(user ? Number((user.quota_bytes / GB).toFixed(3)) : 0);
  let period = $state(user?.quota_period ?? 'none');
  let devices = $state(user?.device_limit ?? 0);
  // Чекбокс «Отключить вручную»: true только для manual-отключения.
  const manualOff0 = user?.disabled && user.disabled_reason === 'manual';
  let manualOff = $state(manualOff0);
  let error = $state('');
  let saving = $state(false);

  function toLocalInput(iso: string): string {
    const d = new Date(iso);
    const p = (n: number) => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}`;
  }

  const errorHints: Record<string, string> = {
    duplicate_username: 'Имя уже занято',
    invalid_expiry: 'Невалидная дата',
    username_required: 'Укажите имя',
    invalid_quota_period: 'Невалидный период',
    negative_value: 'Отрицательное значение',
  };

  async function submit(e: SubmitEvent) {
    e.preventDefault();
    error = '';
    if (!isEdit && username.trim() === '') {
      error = 'Укажите имя';
      return;
    }
    const body: Record<string, unknown> = {
      expiry: new Date(expiry).toISOString(),
      quota_bytes: Math.round(quotaGB * GB),
      quota_period: period,
      device_limit: devices,
    };
    if (!isEdit) body.username = username.trim();
    // disabled шлём только если чекбокс меняли: иначе правка чужого поля
    // ре-включит юзера, отключённого квотой/экспирацией.
    else if (manualOff !== manualOff0) body.disabled = manualOff;
    saving = true;
    try {
      const res = await apiFetch(isEdit ? `/api/users/${user!.id}` : '/api/users', {
        method: isEdit ? 'PATCH' : 'POST',
        body: JSON.stringify(body),
      });
      if (res.ok) {
        onsaved();
        return;
      }
      const data = (await res.json().catch(() => ({}))) as { error?: string };
      error = errorHints[data.error ?? ''] ?? `Ошибка: ${data.error ?? res.status}`;
    } catch {
      error = 'Сеть недоступна';
    } finally {
      saving = false;
    }
  }
</script>

<div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4" role="dialog" aria-modal="true">
  <div class="w-full max-w-md rounded-xl border bg-card p-5 shadow-lg">
    <h2 class="text-lg font-semibold">{isEdit ? 'Изменить пользователя' : 'Новый пользователь'}</h2>
    <form class="mt-4 grid gap-4" onsubmit={submit}>
      <div class="grid gap-1.5">
        <Label for="u-name">Имя</Label>
        <Input id="u-name" bind:value={username} disabled={isEdit} placeholder="ivan" />
        {#if isEdit}
          <p class="text-xs text-muted-foreground">Имя изменить нельзя (ключ статистики)</p>
        {/if}
      </div>
