# Секреты и реальные значения (только на сервере, chmod 600)
.env
.env.*
!.env.example

# Runtime-данные: БД, бэкапы, логи
data/
*.db
*.db-*
backups/
logs/

# Бинарники и артефакты сборки
bin/
/flypanel
web/dist/*
!web/dist/index.html
# /dist/ привязан к корню: без якоря web/dist/ игнорился бы целиком
# и ре-включение !web/dist/index.html выше не работало.
/dist/
coverage/

# Зависимости
node_modules/

# ОС / редакторы / бэкапы файлов
.DS_Store
*.bak-*
